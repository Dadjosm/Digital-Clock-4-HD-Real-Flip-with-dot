+  if (animate) {
+    // if the previous flip is still running, jump to its end state first
+    const QImage from = last_image_;
+    last_image_ = image;
+    if (flip_->start(from, image)) return;
+  }
+  flip_->stop();
+  DrawImage(image);
+}
