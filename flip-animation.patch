diff --git a/digital_clock/gui/flip_animator.cpp b/digital_clock/gui/flip_animator.cpp
new file mode 100644
index 0000000..413b8c8
--- /dev/null
+++ b/digital_clock/gui/flip_animator.cpp
@@ -0,0 +1,239 @@
+/*
+    Digital Clock - beautiful customizable clock with plugins
+    Flip-card transition (added for Flipclock skins).
+    GPLv3 or later, see LICENSE.md
+ */
+
+#include "flip_animator.h"
+
+#include <QPainter>
+#include <QtMath>
+#include <algorithm>
+
+namespace digital_clock {
+namespace gui {
+
+FlipAnimator::FlipAnimator(QObject* parent) :
+  QObject(parent), duration_(420)
+{
+  timer_.setInterval(15);
+  timer_.setTimerType(Qt::PreciseTimer);
+  connect(&timer_, &QTimer::timeout, this, &FlipAnimator::tick);
+}
+
+QVector<QRect> FlipAnimator::findCells(const QImage& src)
+{
+  QVector<QRect> cells;
+  if (src.isNull()) return cells;
+  QImage img = src.format() == QImage::Format_ARGB32_Premultiplied
+      ? src : src.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+
+  const int w = img.width();
+  const int h = img.height();
+  int start = -1;
+  for (int x = 0; x <= w; ++x) {
+    bool used = false;
+    if (x < w) {
+      for (int y = 0; y < h && !used; ++y)
+        used = qAlpha(reinterpret_cast<const QRgb*>(img.constScanLine(y))[x]) != 0;
+    }
+    if (used && start < 0) start = x;
+    if (!used && start >= 0) {
+      cells.append(QRect(start, 0, x - start, h));
+      start = -1;
+    }
+  }
+  return cells;
+}
+
+static bool regionDiffers(const QImage& a, const QImage& b, const QRect& r)
+{
+  for (int y = r.top(); y <= r.bottom(); ++y) {
+    const uchar* pa = a.constScanLine(y) + r.left() * 4;
+    const uchar* pb = b.constScanLine(y) + r.left() * 4;
+    if (memcmp(pa, pb, static_cast<size_t>(r.width()) * 4) != 0) return true;
+  }
+  return false;
+}
+
+bool FlipAnimator::start(const QImage& from, const QImage& to)
+{
+  stop();
+  if (from.isNull() || to.isNull() || from.size() != to.size()) return false;
+
+  from_ = from.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+  to_ = to.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+
+  QVector<QRect> cells = findCells(to_);
+  if (cells.isEmpty()) return false;
+
+  int widest = 0;
+  for (const QRect& r : qAsConst(cells)) widest = std::max(widest, r.width());
+
+  cells_.clear();
+  for (const QRect& r : qAsConst(cells)) {
+    if (r.width() * 10 < widest * 6) continue;   // separators: no flip
+    if (regionDiffers(from_, to_, r)) cells_.append(r);
+  }
+  if (cells_.isEmpty()) return false;
+
+  // everything that does not change between frames is prepared right here
+  flaps_.clear();
+  for (const QRect& r : qAsConst(cells_)) {
+    Flap f;
+    f.rect = r;
+    f.top_h = r.height() / 2;
+    f.bot_h = r.height() - f.top_h;
+    f.old_top = from_.copy(QRect(r.left(), r.top(), r.width(), f.top_h));
+    f.new_bottom = to_.copy(QRect(r.left(), r.top() + f.top_h, r.width(), f.bot_h));
+    flaps_.append(f);
+  }
+  buildBase();
+
+  clock_.start();
+  timer_.start();
+  return true;
+}
+
+void FlipAnimator::buildBase()
+{
+  base_ = to_.copy();
+  QPainter p(&base_);
+  for (const Flap& f : qAsConst(flaps_)) {
+    const QRect top(f.rect.left(), f.rect.top(), f.rect.width(), f.top_h);
+    const QRect bot(f.rect.left(), f.rect.top() + f.top_h, f.rect.width(), f.bot_h);
+    p.setCompositionMode(QPainter::CompositionMode_Source);
+    p.fillRect(f.rect, Qt::transparent);
+    p.setCompositionMode(QPainter::CompositionMode_SourceOver);
+    p.drawImage(top.topLeft(), to_, top);     // new top half
+    p.drawImage(bot.topLeft(), from_, bot);   // old bottom half
+  }
+  p.end();
+}
+
+bool FlipAnimator::retarget(const QImage& to)
+{
+  if (!timer_.isActive() || to.isNull() || to.size() != to_.size()) return false;
+  const QImage nt = to.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+  for (const Flap& f : qAsConst(flaps_))
+    if (regionDiffers(to_, nt, f.rect)) return false;
+  to_ = nt;
+  buildBase();
+  return true;
+}
+
+void FlipAnimator::stop()
+{
+  timer_.stop();
+  cells_.clear();
+  flaps_.clear();
+  base_ = QImage();
+}
+
+void FlipAnimator::tick()
+{
+  qreal p = qreal(clock_.elapsed()) / duration_;
+  if (p >= 1.0) {
+    timer_.stop();
+    cells_.clear();
+    flaps_.clear();
+    base_ = QImage();
+    emit finished(to_);
+    return;
+  }
+  emit frameReady(renderFast(p));
+}
+
+static void drawFlap(QPainter& painter, const QImage& src, const QRect& srcRect,
+                     const QRectF& target, qreal shade, bool shade_from_bottom)
+{
+  QImage flap = src.copy(srcRect);
+  if (shade > 0.0) {
+    QPainter fp(&flap);
+    fp.setCompositionMode(QPainter::CompositionMode_SourceAtop);
+    QLinearGradient g(0, 0, 0, flap.height());
+    QColor dark(0, 0, 0, qBound(0, int(shade * 255), 255));
+    QColor none(0, 0, 0, 0);
+    // darker towards the hinge (middle line)
+    g.setColorAt(shade_from_bottom ? 0.0 : 1.0, none);
+    g.setColorAt(shade_from_bottom ? 1.0 : 0.0, dark);
+    fp.fillRect(flap.rect(), g);
+  }
+  painter.drawImage(target, flap);
+}
+
+QImage FlipAnimator::renderFast(qreal progress) const
+{
+  QImage out = base_.copy();
+  QPainter p(&out);
+  p.setRenderHint(QPainter::SmoothPixmapTransform, true);
+
+  const qreal e = progress < 0.5 ? 2 * progress * progress
+                                 : 1 - qPow(-2 * progress + 2, 2) / 2;
+  const qreal c = qCos(M_PI * e);
+
+  for (const Flap& f : qAsConst(flaps_)) {
+    const qreal hinge = f.rect.top() + f.top_h;
+    if (c >= 0) {
+      const qreal hh = f.top_h * c;
+      drawFlap(p, f.old_top, f.old_top.rect(),
+               QRectF(f.rect.left(), hinge - hh, f.rect.width(), hh),
+               0.55 * (1 - c), true);
+    } else {
+      const qreal hh = f.bot_h * (-c);
+      drawFlap(p, f.new_bottom, f.new_bottom.rect(),
+               QRectF(f.rect.left(), hinge, f.rect.width(), hh),
+               0.55 * (1 + c), false);
+    }
+  }
+  p.end();
+  out.setDevicePixelRatio(to_.devicePixelRatio());
+  return out;
+}
+
+QImage FlipAnimator::renderFrame(const QImage& from, const QImage& to,
+                                 const QVector<QRect>& cells, qreal progress)
+{
+  QImage out = to.copy();
+  QPainter p(&out);
+  p.setRenderHint(QPainter::SmoothPixmapTransform, true);
+
+  // ease-in/out so the card accelerates, then settles
+  const qreal e = progress < 0.5 ? 2 * progress * progress
+                                 : 1 - qPow(-2 * progress + 2, 2) / 2;
+  const qreal theta = M_PI * e;          // 0 .. pi
+  const qreal c = qCos(theta);           // 1 .. -1
+
+  for (const QRect& r : cells) {
+    const int top_h = r.height() / 2;
+    const int bot_h = r.height() - top_h;
+    const QRect top(r.left(), r.top(), r.width(), top_h);
+    const QRect bot(r.left(), r.top() + top_h, r.width(), bot_h);
+
+    // static halves: new top above, old bottom below
+    p.setCompositionMode(QPainter::CompositionMode_Source);
+    p.fillRect(r, Qt::transparent);
+    p.setCompositionMode(QPainter::CompositionMode_SourceOver);
+    p.drawImage(top.topLeft(), to, top);
+    p.drawImage(bot.topLeft(), from, bot);
+
+    const qreal hinge = r.top() + top_h;
+    if (c >= 0) {
+      // old top half folding down towards the hinge
+      const qreal hh = top_h * c;
+      drawFlap(p, from, top, QRectF(r.left(), hinge - hh, r.width(), hh),
+               0.55 * (1 - c), true);
+    } else {
+      // new bottom half unfolding downwards from the hinge
+      const qreal hh = bot_h * (-c);
+      drawFlap(p, to, bot, QRectF(r.left(), hinge, r.width(), hh),
+               0.55 * (1 + c), false);
+    }
+  }
+  p.end();
+  out.setDevicePixelRatio(to.devicePixelRatio());
+  return out;
+}
+
+} // namespace gui
+} // namespace digital_clock
