+void CountdownTimerPlugin::ShowImage(QWidget* widget, const QImage& raw, bool animate)
+{
+  using digital_clock::gui::FlipAnimator;
+  ClickableLabel* label = static_cast<ClickableLabel*>(widget);
+
+  const QImage to = Tinted(raw);
+  const QImage from = widget->property("cd_shown").value<QImage>();
+  widget->setProperty("cd_raw", raw);
+  widget->setProperty("cd_shown", to);
+
+  FlipAnimator* fa = widget->findChild<FlipAnimator*>();
+  if (!fa) {
+    fa = new FlipAnimator(widget);
+    auto show = [label](const QImage& frame) { label->setPixmap(QPixmap::fromImage(frame)); };
+    connect(fa, &FlipAnimator::frameReady, label, show);
+    connect(fa, &FlipAnimator::finished, label, show);
+  }
+
+  if (flip_skin_) {
+    // only the separator/colon changed while flipping: keep flipping
+    if (fa->isRunning() && fa->retarget(to)) return;
+    if (animate && !from.isNull() && fa->start(from, to)) return;
+  }
+  fa->stop();
+  label->setPixmap(QPixmap::fromImage(to));
 }
 
