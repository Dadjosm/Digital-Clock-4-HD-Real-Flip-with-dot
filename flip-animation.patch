@@ -0,0 +1,72 @@
+/*
+    Digital Clock - beautiful customizable clock with plugins
+    Flip-card transition (added for Flipclock skins).
+
+    This program is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 3 of the License, or
+    (at your option) any later version.
+ */
+
+#ifndef DIGITAL_CLOCK_GUI_FLIP_ANIMATOR_H
+#define DIGITAL_CLOCK_GUI_FLIP_ANIMATOR_H
+
+#include <QObject>
+#include <QElapsedTimer>
+#include <QImage>
+#include <QRect>
+#include <QTimer>
+#include <QVector>
+
+namespace digital_clock {
+namespace gui {
+
+/*!
+ * Turns "image A -> image B" into a sequence of frames where every card
+ * (a horizontal run of non-transparent columns) whose pixels changed is
+ * flipped like a mechanical flip clock: the old top half folds down and
+ * the new bottom half folds out underneath it.
+ * Narrow cells (separators) are not flipped, they just switch.
+ */
+class FlipAnimator : public QObject
+{
+  Q_OBJECT
+
+public:
+  explicit FlipAnimator(QObject* parent = nullptr);
+
+  bool isRunning() const { return timer_.isActive(); }
+  void setDuration(int msec) { duration_ = msec; }
+
+  /// Starts flipping from 'from' to 'to'. Returns false (and emits nothing)
+  /// when the images are not compatible, caller should just show 'to'.
+  bool start(const QImage& from, const QImage& to);
+  /// Stops animation without emitting the final frame.
+  void stop();
+
+  /// Splits image into cards by fully transparent columns (exposed for tests).
+  static QVector<QRect> findCells(const QImage& img);
+  /// Renders one frame, progress in [0, 1] (exposed for tests).
+  static QImage renderFrame(const QImage& from, const QImage& to,
+                            const QVector<QRect>& cells, qreal progress);
+
+signals:
+  void frameReady(const QImage& frame);
+  void finished(const QImage& final_image);
+
+private slots:
+  void tick();
+
+private:
+  QImage from_;
+  QImage to_;
+  QVector<QRect> cells_;
+  QTimer timer_;
+  QElapsedTimer clock_;
+  int duration_;
+};
+
+} // namespace gui
+} // namespace digital_clock
+
+#endif // DIGITAL_CLOCK_GUI_FLIP_ANIMATOR_H
