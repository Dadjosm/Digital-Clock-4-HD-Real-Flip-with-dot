+void colorize_cards(const QImage& srcImage, QImage& destImage, const QColor& color, qreal strength)
+{
+  strength = qBound(qreal(0), strength, qreal(1));
+  if (srcImage.isNull() || qFuzzyIsNull(strength)) {
+    destImage = srcImage;
+    return;
+  }
+
+  const QImage src = srcImage.convertToFormat(QImage::Format_ARGB32);
+  QImage dst = src.copy();
+  const int h = src.height();
+  const int mid = h / 2;
+  const int band = std::max(2, h * 15 / 1000);   // rows around the seam
+
+  const QVector<QRect> cells = FlipAnimator::findCells(src);
+  int widest = 0;
+  for (const QRect& r : cells) widest = std::max(widest, r.width());
+
+  const qreal cr = color.red(), cg = color.green(), cb = color.blue();
+
+  for (const QRect& cell : cells) {
+    if (cell.width() * 10 < widest * 6) continue;   // separators: leave as is
+
+    // per half: card body level = most frequent grey, digit level = brightest
+    int body[2] = {0, 0};
+    int digit[2] = {255, 255};
+    for (int half = 0; half < 2; ++half) {
+      const int y0 = half ? mid + band : 0;
+      const int y1 = half ? h : mid - band;
+      int hist[256] = {0};
+      int mx = 0;
+      for (int y = y0; y < y1; ++y) {
+        const QRgb* line = reinterpret_cast<const QRgb*>(src.constScanLine(y));
+        for (int x = cell.left(); x <= cell.right(); ++x) {
+          if (qAlpha(line[x]) < 250) continue;
+          const int g = qGray(line[x]);
+          ++hist[g];
+          mx = std::max(mx, g);
+        }
+      }
+      int mode = 0;
+      for (int i = 1; i < 256; ++i) if (hist[i] > hist[mode]) mode = i;
+      body[half] = std::max(1, mode);
+      // digit face = most frequent bright level (ignores rare edge highlights)
+      int dmode = -1;
+      for (int i = std::min(255, mode + 40); i < 256; ++i)
+        if (hist[i] > 0 && (dmode < 0 || hist[i] > hist[dmode])) dmode = i;
+      digit[half] = dmode >= 0 ? dmode : 255;
+      (void)mx;
+    }
+
+    for (int y = 0; y < h; ++y) {
+      const int half = y < mid ? 0 : 1;
+      const QRgb* in = reinterpret_cast<const QRgb*>(src.constScanLine(y));
+      QRgb* out = reinterpret_cast<QRgb*>(dst.scanLine(y));
+      const qreal span = std::max(1, digit[half] - body[half]);
+      for (int x = cell.left(); x <= cell.right(); ++x) {
+        const QRgb p = in[x];
+        const int a = qAlpha(p);
+        if (a == 0) continue;
+        const int g = qGray(p);
+        // c: how much of this pixel is the digit (0 = card body, 1 = digit)
+        const qreal c = qBound(qreal(0), (g - body[half]) / span, qreal(1));
+        // card shading relative to the top half body, seam/shadows get darker
+        const qreal k = std::min(qreal(1), std::min<qreal>(g, body[half]) / body[0]);
+        const qreal tr = cr * k, tg = cg * k, tb = cb * k;
+        const qreal d = digit[half];
+        const qreal nr = c * d + (1 - c) * tr;
+        const qreal ng = c * d + (1 - c) * tg;
+        const qreal nb = c * d + (1 - c) * tb;
+        const qreal r = qRed(p) + (nr - qRed(p)) * strength;
+        const qreal gg = qGreen(p) + (ng - qGreen(p)) * strength;
+        const qreal b = qBlue(p) + (nb - qBlue(p)) * strength;
+        out[x] = qRgba(qBound(0, int(r + 0.5), 255), qBound(0, int(gg + 0.5), 255),
+                       qBound(0, int(b + 0.5), 255), a);
+      }
+    }
+  }
+
+  dst.setDevicePixelRatio(srcImage.devicePixelRatio());
+  destImage = dst.convertToFormat(srcImage.format());
+  destImage.setDevicePixelRatio(srcImage.devicePixelRatio());
+}
+
 } // namespace gui
 } // namespace digital_clock
